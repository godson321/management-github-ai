{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Batch Manager",
  "version": "0.2.0",
  "identifier": "ai.management.githubbatchmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GitHub Batch Manager",
        "width": 1320,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
